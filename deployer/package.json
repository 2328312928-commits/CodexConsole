{
  "name": "codex-console-deploy",
  "private": true,
  "version": "0.1.0",
  "description": "Deploys Codex Console to your own server from a page in your browser, without a terminal.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node dist/deploy.cjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ssh2": "1.15.6",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
