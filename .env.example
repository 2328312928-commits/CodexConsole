# Codex Console configuration. Copy to `.env` (gitignored) and adjust.
# On a server set up with deploy/deploy.sh these settings live in /etc/codex-console/env
# (managed) and /etc/codex-console/local.env (yours).
# Secrets (password hash, TOTP secret, key pepper) are NOT configured here:
# `npm run setup` generates them into CC_DATA_DIR with owner-only permissions.

# --- Network -------------------------------------------------------------
# Bind address. Keep 127.0.0.1 unless you put the console behind HTTPS.
CC_HOST=127.0.0.1
CC_PORT=8787
# The URL you open in the browser. Used for Origin/Host checks and cookie security.
# Example: https://console.example.com (behind Caddy) or https://mybox.tailnet-name.ts.net
# CC_PUBLIC_ORIGIN=http://127.0.0.1:8787
# Extra Host header values to accept (comma separated), e.g. a LAN name.
# CC_ALLOWED_HOSTS=
# Built-in HTTPS: paths to a PEM certificate chain and private key.
# CC_TLS_CERT=/path/to/fullchain.pem
# CC_TLS_KEY=/path/to/privkey.pem
# Set when a reverse proxy (Caddy, nginx, tailscale serve) terminates TLS:
# "loopback" trusts X-Forwarded-* only from 127.0.0.1/::1.
# CC_TRUST_PROXY=loopback
# Plain HTTP on a non-loopback address is refused unless you set this. Don't.
# CC_ALLOW_INSECURE_HTTP=false

# --- Storage -------------------------------------------------------------
# Database, secrets and media cache (created with 0700 permissions).
# CC_DATA_DIR=~/.codexconsole
# The folder Codex sessions work in; the file browser cannot leave it.
# CC_WORKSPACE_ROOT=~/codex-workspace

# --- Codex ---------------------------------------------------------------
# Path to the codex binary. Default: the version pinned in package.json.
# CODEX_BIN=/usr/local/bin/codex
# read-only | workspace-write | danger-full-access
CC_CODEX_SANDBOX=workspace-write
# untrusted | on-request | never  (defaults for new sessions; editable in Admin → Settings)
CC_CODEX_APPROVAL=on-request
# Allow network access inside the workspace-write sandbox.
CC_CODEX_NETWORK=false
# Default model (empty = Codex default).
# CC_CODEX_MODEL=
# Unanswered approval requests are declined after this many seconds.
CC_APPROVAL_TIMEOUT_SEC=600

# --- Limits --------------------------------------------------------------
CC_MAX_UPLOAD_MB=200
CC_MAX_PROMPT_CHARS=100000
CC_RATE_PROMPTS_PER_MIN=20
CC_RATE_API_PER_MIN=600
CC_RATE_UPLOAD_MB_PER_HOUR=2048

# --- Sessions and logs ---------------------------------------------------
# A browser signed in with an API key stays signed in this long without use,
# and at most this many days in total.
CC_SESSION_IDLE_HOURS=12
CC_SESSION_MAX_DAYS=7
# Admin area asks for a fresh authenticator code after this much inactivity.
CC_ADMIN_IDLE_MIN=15
# Request/security logs older than this are deleted (also editable in admin).
CC_LOG_RETENTION_DAYS=180

# --- Public API (API keys) -----------------------------------------------
# A second listener for your own scripts: serves only /v1 and only accepts API
# keys with API scopes (Admin → Keys). Off by default here; deploy/deploy.sh turns
# it on behind Caddy. It speaks plain HTTP on loopback; put TLS in front to reach
# it from the internet (Caddy, or Tailscale Funnel: docs/FUNNEL.md).
CC_API_ENABLED=false
CC_API_HOST=127.0.0.1
CC_API_PORT=8788
# The URL your tools call, e.g. https://mybox.tailnet-name.ts.net:8443 behind Funnel.
# CC_API_PUBLIC_ORIGIN=http://127.0.0.1:8788
# Client address from a PROXY protocol header (Funnel --proxy-protocol=2):
# off | optional | required. Use "required" behind Funnel.
CC_API_PROXY_PROTOCOL=optional
# Behind an HTTP reverse proxy instead (Caddy): take the client IP from X-Forwarded-For.
# CC_API_TRUST_PROXY=loopback
# Requests per minute for the whole listener, failed keys per IP per 10 minutes,
# and the longest a request may wait for a turn to finish ("wait": true).
CC_API_MAX_PER_MIN=600
CC_API_BAD_KEY_LIMIT=20
CC_API_MAX_WAIT_SEC=600
